<JavaScript class="com.fr.js.JavaScriptImpl">
<Parameters/>
<Content>
<![CDATA[/**
 * 综合校验逻辑（分四组独立判断）：
 * 当“是否包含下级”被选中时，分别检查四组冲突情况。
 */
function validateOrgConflict() {
    // 1. 获取所有相关控件
    var recOrgIdWidget  = contentPane.parameterEl.getWidgetByName("recOrgId");     // 借出组织
    var orgIdWidget     = contentPane.parameterEl.getWidgetByName("orgId");        // 借入组织
    var recOrgTagWidget = contentPane.parameterEl.getWidgetByName("recOrgTag");    // 借出组织标签
    var orgTagWidget    = contentPane.parameterEl.getWidgetByName("orgTag");       // 借入组织标签
    var containWidget   = contentPane.parameterEl.getWidgetByName("contain");      // 是否包含下级

    // 如果关键控件不存在，直接通过
    if (!recOrgIdWidget || !orgIdWidget || !containWidget) {
        return true;
    }

    // 2. 获取值
    var recOrgIdVal  = recOrgIdWidget.getValue();
    var orgIdVal     = orgIdWidget.getValue();
    var recOrgTagVal = recOrgTagWidget ? recOrgTagWidget.getValue() : null;
    var orgTagVal    = orgTagWidget ? orgTagWidget.getValue() : null;
    var containVal   = containWidget.getValue();

    // 3. 定义通用的判空函数
    function hasValue(val) {
        if (val === null || val === undefined) return false;
        if (Array.isArray(val)) return val.length > 0;
        return val.toString().trim().length > 0;
    }

    // 4. 判断各个字段是否有值
    var hasRecOrgId = hasValue(recOrgIdVal);
    var hasOrgId    = hasValue(orgIdVal);
    var hasRecTag   = hasValue(recOrgTagVal);
    var hasOrgTag   = hasValue(orgTagVal);
    var hasContain  = hasValue(containVal);

    // 5. 核心校验：拆分为四组独立判断
    
    // 如果“是否包含下级”没有值，直接通过，无需后续校验
    if (!hasContain) {
        return true;
    }

    // --- 第一组：借出组织 + 借入组织 ---
    if (hasRecOrgId && hasOrgId) {
        alert("借出组织和借入组织同时存在时，不能选择“是否包含下级”。");
        containWidget.setValue("");
        return false;
    }

    // --- 第二组：借出标签 + 借入标签 ---
    if (hasRecTag && hasOrgTag) {
        alert("借出组织标签和借入组织标签同时存在时，不能选择“是否包含下级”。");
        containWidget.setValue("");
        return false;
    }

    // --- 第三组：借出组织 + 借入标签 (交叉) ---
    if (hasRecOrgId && hasOrgTag) {
        alert("借出组织和借入组织标签同时存在时，不能选择“是否包含下级”。");
        containWidget.setValue("");
        return false;
    }

    // --- 第四组：借入组织 + 借出标签 (交叉) ---
    if (hasOrgId && hasRecTag) {
        alert("借入组织和借出组织标签同时存在时，不能选择“是否包含下级”。");
        containWidget.setValue("");
        return false;
    }

    // 校验通过
    return true;
}

// 执行校验
return validateOrgConflict();]]></Content>
</JavaScript>
</Listener>
