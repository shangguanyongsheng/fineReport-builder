<Widget class="com.fr.form.ui.container.WAbsoluteLayout$BoundsWidget">
<InnerWidget class="com.fr.form.ui.FreeButton">
<Listener event="click" name="点击1">
<JavaScript class="com.fr.js.JavaScriptImpl">
<Parameters/>
<Content>
<![CDATA[
var count = this.options.form.getWidgetByName("count").getValue();
var pageSize = this.options.form.getWidgetByName("size").getValue();
var number = this.options.form.getWidgetByName("current").getValue();
if(count==null||count==0){
    this.setEnable(false);
    _g().parameterCommit();
    this.setEnable(true);
}
var countNumber = this.options.form.getWidgetByName("countNumber").getValue();
var intNumber = parseInt(number);
console.log("intNumber",intNumber);
console.log("countNumber==",countNumber);
if (intNumber < countNumber && countNumber > 1) {
	this.options.form.getWidgetByName("current").setValue(intNumber + 1);
	 
} else {
	this.options.form.getWidgetByName("current").setValue(intNumber);
	 
}
 
this.setEnable(false);
_g().parameterCommit();
this.setEnable(true);]]></Content>
</JavaScript>
</Listener>
