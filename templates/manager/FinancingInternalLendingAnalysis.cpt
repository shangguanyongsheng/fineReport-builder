<Desensitizations desensitizeOpen="false"/>
<Parameters/>
<Attributes maxMemRowCount="-1"/>
<Connection class="com.fr.data.impl.NameDatabaseConnection">
<DatabaseName>
<![CDATA[cfs-report]]></DatabaseName>
</Connection>
<Query>
<![CDATA[select concat(id,'') as id,code,dict_key,dict_value from sys_dict where code = 'currency' and is_deleted = 0]]></Query>
<PageQuery>
<![CDATA[]]></PageQuery>
